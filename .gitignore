# IDE
.idea/
*.iml
.metadata

# Flutter
.dart_tool/
.flutter-plugins-dependencies
build/

# Logs
*.log
flutter_*.log

# OS
.DS_Store

# Migration backups (originals recoverable from git)
*.db.bak
__pycache__/
.cache/

# Uncompressed corpus: built by tools/build_corpus.py, shipped as .gz
assets/theology.db
assets/theology.db.bak
# Ad-hoc copies taken before a destructive prune. `git checkout` cannot restore
# any of these — the .db above is ignored too, and theology.db.gz is the 9 MB
# bundled core, not the 895 MB corpus — so a local copy is the only way back,
# and it must never be committed: at 895 MB it is nine times GitHub's hard
# per-file limit and the push would be rejected.
assets/theology.db.presafe
assets/*.db.presafe

# Embedding model weights: ~22MB, fetched by tools/fetch_model.sh
assets/model/*.onnx

# Built content packs. Published as GitHub Release assets, not committed:
# the largest is 24 MB and they are reproducible from the corpus.
dist/

# The large ingest outputs. These are build artefacts, not sources: each is
# regenerated by its ingester's `parse` step from the cached downloads, and
# `load_ccel.py` consumes them on the way into the database. The Reformation
# one is 296 MB, which GitHub refuses outright — its per-file hard limit is
# 100 MB — so tracking it would make the repository unpushable.
#
#     python3 tools/ingest_reformation.py parse
#     python3 tools/ingest_owen.py parse
#     python3 tools/ingest_treasury.py parse
#
# The smaller units files stay tracked, because a readable diff of a confession
# or a catechism is worth having. `newadvent_units.json` is 82 MB and tracked
# from before this rule; it is left alone rather than rewritten out of history.
tools/data/reformation_units.json
tools/data/owen_units.json
tools/data/treasury_units.json

# Local Python environment for the corpus tools (onnxruntime, numpy).
.venv/
